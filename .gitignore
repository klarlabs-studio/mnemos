# macOS
.DS_Store

# Local tool caches
.ruff_cache/

data/ingestion/*
!data/ingestion/.gitkeep

# Build artifacts
bin/
dist/
/mnemos
/mnemos-mcp

# Editor/tool local state
.claude/

# Coverage and test outputs
*.out
coverage.txt

# Benchmark run artifacts
benchmarks/results/*.json

# Local databases
*.db

# Local extraction cache
data/cache/

# Mutation harness reports
mutation-*.json
mutation-*.log
/mutate

# Cognitive-process evaluation reports (`make brain-eval`). Not committed: the
# numbers are only meaningful next to the code revision that produced them, so
# a stale checked-in report is worse than none.
brainbench.json

# Nox local state — but the baseline IS committed on purpose: the shared go-ci
# security gate stays report-only until a baseline is tracked, and only then
# starts failing the build on net-new critical/high findings.
.nox/*
!.nox/baseline.json
!.nox/waivers.yaml

# SBOM artifacts generated by nox during release (uploaded by goreleaser)
sbom-out/

# nox scan artifacts (regenerated by `nox scan`; the baseline is the tracked state)
findings.json
ai.inventory.json

# Local planning/release tool state (roady, relicta). Untracked in #382
# Phase 6: both were abandoned (last touched June/May 2026) and planning now
# lives in GitHub issues. Git history keeps the old snapshots.
.roady/
.relicta/
